<% if notice.present? %>
  <div
    id="flash-notice"
    class="mb-4 flex items-center gap-3 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700"
  >
    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-green-100">
      ✓
    </span>
    <%= notice %>
  </div>
<% end %>

<% if alert.present? %>
  <div
    id="flash-alert"
    class="mb-4 flex items-center gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"
  >
    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100">
      ✕
    </span>
    <%= alert %>
  </div>
<% end %>
