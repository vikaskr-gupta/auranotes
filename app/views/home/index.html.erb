<% if user_signed_in? && @notes.count > 0 %>

<% content_for :title, "Notes" %>

  <div class="mx-auto max-w-6xl mt-6">

    <!-- Header -->
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="mb-1 text-sm font-medium text-gray-500">
          Your workspace
        </p>

        <h1 class="text-3xl font-bold tracking-tight text-gray-900">
          Notes
        </h1>

        <p class="mt-1 text-sm text-gray-500">
          Create, organize and manage your notes.
        </p>
      </div>

      <%= link_to new_note_path,
          class: "inline-flex items-center justify-center gap-2 rounded-lg bg-gray-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-gray-800" do %>
        <span class="text-lg leading-none">+</span>
        New note
      <% end %>
    </div>

    <!-- Notes -->
    <div id="notes">

      <% if @notes.any? %>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

          <% @notes.each do |note| %>

            <div class="group rounded-2xl border border-t-8 <%= "border-t-#{note.color}-500" %> border-gray-200 p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <!-- Note content -->
              <div class="min-h-32">
                <%= render note %>
              </div>

              <!-- Actions -->
              <div class="mt-6 flex items-center gap-2 border-t border-gray-100 pt-4">

                <%= link_to "View",
                    note,
                    class: "flex-1 rounded-lg bg-gray-900 px-3 py-2 text-center text-sm font-medium text-white transition hover:bg-gray-800" %>

                <%= link_to "Edit",
                    edit_note_path(note),
                    class: "rounded-lg border border-gray-200 px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50" %>

                <%= button_to "Delete",
                    note,
                    method: :delete,
                    class: "rounded-lg border border-red-200 px-3 py-2 text-sm font-medium text-red-600 transition hover:bg-red-50",
                    data: { turbo_confirm: "Are you sure you want to delete this note?" } %>

              </div>
            </div>
          <% end %>

        </div>

      <% else %>

        <!-- Empty state -->
        <div class="rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-16 text-center">

          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-gray-100 text-2xl">
            📝
          </div>

          <h2 class="mt-5 text-lg font-semibold text-gray-900">
            No notes yet
          </h2>

          <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-gray-500">
            Start capturing your ideas, thoughts and important information by creating your first note.
          </p>

          <%= link_to "Create your first note",
              new_note_path,
              class: "mt-6 inline-flex rounded-lg bg-gray-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-gray-800" %>

        </div>

      <% end %>

    </div>

  </div>

<% else %>
  <%= render 'landing' %>
<% end %>