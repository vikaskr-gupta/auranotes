<div id="<%= dom_id note %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <h3 class="text-2xl font-semibold">
      <%= note.title %>
    </h3>
    <p class="text-xs">
      <%= note.created_at.strftime("%B %d, %Y") %>
    </p>
  </div>
  <div>
    <p class="text-sm text-gray-700 wrap-break-word">
      <%= note.description.truncate(100) %>
    </p>
  </div>
</div>
