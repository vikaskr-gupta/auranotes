<% content_for :title, "Showing note" %>

<div class="mx-auto max-w-3xl mt-6">

  <!-- Header -->
  <div class="mb-8">
    <%= link_to root_path,
        class: "mb-5 inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition hover:text-gray-900" do %>
      <span>←</span>
      Back to notes
    <% end %>

    <p class="mb-1 text-sm font-medium text-gray-500">
      Note
    </p>

    <h1 class="text-3xl font-bold tracking-tight text-gray-900">
      Note details
    </h1>

    <p class="mt-2 text-sm text-gray-500">
      View the details of your note or make changes to it.
    </p>
  </div>

  <!-- Note Card -->
  <div class="rounded-2xl border border-t-8 <%= "border-t-#{@note.color}-500" %> border-gray-200 bg-white p-6 shadow-sm sm:p-8">

    <div class="min-h-48">
      <%= render @note %>
    </div>

    <!-- Actions -->
    <div class="mt-8 flex flex-col gap-3 border-t border-gray-100 pt-6 sm:flex-row sm:items-center">

      <%= link_to "Edit note",
          edit_note_path(@note),
          class: "inline-flex items-center justify-center rounded-lg bg-gray-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-gray-800" %>

      <%= link_to "Back to notes",
          root_path,
          class: "inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white px-5 py-3 text-sm font-medium text-gray-700 transition hover:bg-gray-50" %>

      <%= button_to "Delete note",
          @note,
          method: :delete,
          class: "inline-flex cursor-pointer items-center justify-center rounded-lg border border-red-200 px-5 py-3 text-sm font-medium text-red-600 transition hover:bg-red-50",
          data: { turbo_confirm: "Are you sure you want to delete this note?" } %>

    </div>

  </div>

</div>