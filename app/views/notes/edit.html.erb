<% content_for :title, "Editing note" %>

<div class="mx-auto max-w-3xl mt-6">

  <!-- Header -->
  <div class="mb-8">
    <%= link_to @note,
        class: "mb-5 inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition hover:text-gray-900" do %>
      <span>←</span>
      Back to note
    <% end %>

    <p class="mb-1 text-sm font-medium text-gray-500">
      Notes
    </p>

    <h1 class="text-3xl font-bold tracking-tight text-gray-900">
      Edit note
    </h1>

    <p class="mt-2 text-sm leading-6 text-gray-500">
      Update your note and save your changes.
    </p>
  </div>

  <!-- Form Card -->
  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">

    <%= render "form", note: @note %>

    <!-- Secondary Actions -->
    <div class="mt-6 flex flex-col gap-3 border-t border-gray-100 pt-6 sm:flex-row">

      <%= link_to "View note",
          @note,
          class: "inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white px-5 py-3 text-sm font-medium text-gray-700 transition hover:bg-gray-50" %>

      <%= link_to "Back to notes",
          root_path,
          class: "inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white px-5 py-3 text-sm font-medium text-gray-700 transition hover:bg-gray-50" %>

    </div>

  </div>

</div>